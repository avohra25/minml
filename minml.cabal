cabal-version:      2.4
name:               minml
version:            0.1.0
synopsis:           A small ML with Hindley-Milner type inference and an interpreter
description:
  MiniML is a small, strict, purely functional ML dialect with principal
  type inference (Algorithm W), let-polymorphism, tuples, lists and
  pattern matching, an environment-based interpreter, a prelude written
  in MiniML and a REPL.
license:            MIT
license-file:       LICENSE
author:             Aryan Vohra
maintainer:         182703837+avohra25@users.noreply.github.com
category:           Language
build-type:         Simple
extra-doc-files:    README.md

common shared
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >=4.14 && <5, containers >=0.6 && <0.8

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    MiniML.Syntax
    MiniML.Lexer
    MiniML.Parser

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   tests
  main-is:          Main.hs
  other-modules:    Harness ParserSpec
  build-depends:    minml
